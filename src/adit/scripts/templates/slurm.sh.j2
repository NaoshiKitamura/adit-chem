#!/bin/bash
#SBATCH --job-name={{ runtime.job_name }}
#SBATCH --nodes={{ runtime.nodes }}
#SBATCH --ntasks-per-node={{ runtime.mpiprocs }}
#SBATCH --cpus-per-task={{ runtime.omp_threads }}
#SBATCH --time={{ runtime.walltime }}
#SBATCH --output=slurm-%j.out
{% for line in profile.header_extra %}
{{ line }}
{% endfor %}
{% if lang == "en" %}
# generated by adit {{ app_version }} ({{ created }}). Target: Slurm (profile {{ runtime.profile }})
# Syntax: https://slurm.schedmd.com/sbatch.html (--job-name, --nodes, --ntasks-per-node, --cpus-per-task, --time, --output)
# Usage: transfer this directory and run  {{ profile.submit }} submit.sh  inside it
{% else %}
# adit {{ app_version }} が生成 ({{ created }})。実行先: Slurm (プロファイル {{ runtime.profile }})
# 書式は https://slurm.schedmd.com/sbatch.html (--job-name, --nodes, --ntasks-per-node, --cpus-per-task, --time, --output)
# 使い方: このディレクトリを転送し、その中で  {{ profile.submit }} submit.sh
{% endif %}

cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}"

{% if modules %}
if ! command -v module >/dev/null 2>&1; then
   [ -r /etc/profile ] && . /etc/profile
fi
command -v module >/dev/null 2>&1 || { echo "{{ 'module command not available' if lang == 'en' else 'module コマンドが使えない' }}" >&2; exit 1; }
module purge
{% for m in modules %}
module load {{ m }} || { echo "{{ 'module load ' ~ m ~ ' failed' if lang == 'en' else 'module load ' ~ m ~ ' に失敗' }}" >&2; exit 1; }
{% endfor %}
{% endif %}

export OMP_NUM_THREADS={{ runtime.omp_threads }}
{% for k, v in env.items() %}
export {{ k }}="{{ v }}"
{% endfor %}
{{ run_command }}
